# App
NEXT_PUBLIC_APP_NAME=tpl
NEXT_PUBLIC_API_URL=/api

# Server-only values. They are read at runtime and must never use the
# NEXT_PUBLIC_ prefix.
APP_ORIGIN=http://localhost:3000
WEB_BACKEND_INTERNAL_URL=http://127.0.0.1:8000
DEPLOYMENT_ID=local

# NEXT_PUBLIC_API_URL is intentionally restricted to a same-origin path.
# Authentication, session storage and provider credentials belong to the
# paired Nest Web Backend and must never be placed in this repository.
